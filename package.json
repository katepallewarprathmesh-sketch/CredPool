{
  "name": "credpool",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "gas": "REPORT_GAS=true hardhat test test/GatedPool.test.ts",
    "deploy": "hardhat run scripts/deploy.ts",
    "demo": "hardhat run scripts/demo.ts",
    "issuer": "tsx issuer-service/src/server.ts",
    "frontend": "npm --prefix frontend run dev",
    "test:issuer": "mocha --require tsx/cjs issuer-service/test/**/*.test.ts",
    "test:all": "npm test && npm run test:issuer && npm run test:frontend",
    "verify:sepolia": "hardhat run scripts/verify.ts --network sepolia",
    "test:foundry": "forge test",
    "test:frontend": "npm --prefix frontend run build && npm --prefix frontend run test:e2e",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm test && npm run test:issuer && npm --prefix frontend run build",
    "clean:all": "node scripts/clean.mjs all",
    "sanity:sepolia": "hardhat run scripts/sanity.ts --network sepolia"
  },
  "devDependencies": {
    "@helia/unixfs": "5.1.0",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@openzeppelin/contracts": "5.1.0",
    "@types/chai": "4.3.20",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "canonicalize": "2.1.0",
    "chai": "4.5.0",
    "cors": "2.8.6",
    "did-jwt": "8.0.18",
    "did-jwt-vc": "4.0.16",
    "did-resolver": "4.1.0",
    "dotenv": "16.6.1",
    "ethers": "6.17.0",
    "ethr-did-resolver": "11.1.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "hardhat": "2.29.1",
    "hardhat-gas-reporter": "1.0.10",
    "helia": "5.5.1",
    "mocha": "11.8.0",
    "multiformats": "13.4.2",
    "pkh-did-resolver": "2.0.0",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "1.4.3",
    "solidity-coverage": "0.8.17",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "zod": "4.1.12"
  }
}
